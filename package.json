{
  "name": "psyche-clinic",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server": "node --env-file-if-exists=.env server/start.js",
    "dev:all": "npm run dev",
    "test:server": "node --test server/test/*.test.js",
    "test:production": "npm run test:server && npm test && npm run build",
    "netlify:dev": "netlify dev",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "db:check-role": "node --env-file-if-exists=.env server/db/check-runtime-role.js",
    "db:transfer": "node --env-file-if-exists=.env server/db/transfer-sqlite.js",
    "db:transfer:dry": "node --env-file-if-exists=.env server/db/transfer-sqlite.js --dry-run"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "vite": "4.5.14",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "serverless-http": "^3.2.0"
  }
}
