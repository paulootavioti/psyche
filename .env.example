# Backend
PORT=8787
PSYCHE_DB_PATH=./data/psyche.sqlite
# PostgreSQL de produção. Enquanto a adaptação da API não for concluída,
# PSYCHE_DB_PATH continua sendo usado pela aplicação atual.
# PSYCHE_DATABASE_URL=postgresql://psyche_migration:senha@host:5432/psyche
PSYCHE_DB_SSL=true
PSYCHE_DB_SSL_REJECT_UNAUTHORIZED=true
# Caminho para o certificado raiz baixado do provedor PostgreSQL.
# PSYCHE_DB_SSL_CA_PATH=./certs/supabase-ca.crt
PSYCHE_DB_POOL_SIZE=10
# Ative somente após executar as migrações e validar o login em homologação.
PSYCHE_AUTH_STORE=sqlite
PSYCHE_PATIENT_STORE=sqlite
PSYCHE_CLINICAL_STORE=sqlite
PSYCHE_SESSION_STORE=sqlite
PSYCHE_DOCUMENT_STORE=sqlite
PSYCHE_FINANCE_STORE=sqlite
PSYCHE_PAYABLES_STORE=sqlite
PSYCHE_RECEIPT_STORE=sqlite
PSYCHE_INVOICE_STORE=sqlite
PSYCHE_AGENDA_STORE=sqlite
PSYCHE_ADMIN_STORE=sqlite
PSYCHE_ENGAGEMENT_STORE=sqlite
PSYCHE_OPERATIONS_STORE=sqlite
PSYCHE_ANALYTICS_STORE=sqlite
PSYCHE_APP_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
PSYCHE_ADMIN_PASSWORD=defina-uma-senha-forte-com-mais-de-12-caracteres
PSYCHE_DATA_KEY=gere-uma-chave-aleatoria-de-pelo-menos-32-bytes

# Frontend (Vite)
# Em desenvolvimento, deixe VITE_API_URL vazio para usar o proxy do Vite.
# VITE_API_URL=https://api.exemplo.com/api
