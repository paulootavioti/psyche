# Backend
PORT=8787
# Utilizado somente no modo local legado e nos testes SQLite.
PSYCHE_DB_PATH=./data/psyche.sqlite
# PostgreSQL é a fonte principal em produção.
PSYCHE_DATABASE_URL=postgresql://usuario:senha@host:5432/psyche
# Use uma credencial administrativa separada somente para migrações locais/CI.
# Nunca disponibilize esta variável às Functions do Netlify.
# PSYCHE_MIGRATION_DATABASE_URL=postgresql://postgres:senha-admin@host:5432/postgres
PSYCHE_DB_SSL=true
PSYCHE_DB_SSL_REJECT_UNAUTHORIZED=true
# Caminho para o certificado raiz. Em serverless, prefira a cadeia confiável
# fornecida pelo provedor em vez de depender de um arquivo local.
# PSYCHE_DB_SSL_CA_PATH=./certs/supabase-ca.crt
# Alternativas adequadas ao Netlify (use somente uma delas):
# PSYCHE_DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PSYCHE_DB_SSL_CA_BASE64=certificado_codificado_em_base64
PSYCHE_DB_POOL_SIZE=4
PSYCHE_DB_IDLE_TIMEOUT_MS=30000
PSYCHE_DB_CONNECT_TIMEOUT_MS=10000
PSYCHE_AUTH_STORE=postgres
PSYCHE_PATIENT_STORE=postgres
PSYCHE_CLINICAL_STORE=postgres
PSYCHE_SESSION_STORE=postgres
PSYCHE_DOCUMENT_STORE=postgres
PSYCHE_FINANCE_STORE=postgres
PSYCHE_PAYABLES_STORE=postgres
PSYCHE_RECEIPT_STORE=postgres
PSYCHE_INVOICE_STORE=postgres
PSYCHE_AGENDA_STORE=postgres
PSYCHE_ADMIN_STORE=postgres
PSYCHE_ENGAGEMENT_STORE=postgres
PSYCHE_OPERATIONS_STORE=postgres
PSYCHE_ANALYTICS_STORE=postgres
PSYCHE_APP_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
PSYCHE_ADMIN_PASSWORD=defina-uma-senha-forte-com-mais-de-12-caracteres
PSYCHE_DATA_KEY=gere-uma-chave-aleatoria-de-pelo-menos-32-bytes

# Frontend (Vite)
# Em desenvolvimento, deixe VITE_API_URL vazio para usar o proxy do Vite.
# No Netlify, mantenha vazio para usar /api no mesmo domínio.
# VITE_API_URL=
